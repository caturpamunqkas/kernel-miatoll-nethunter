# SDR — miatoll. RTL-SDR (RTL2832U), HackRF, Airspy, Mirics MSi2500.
#
# Catatan: dokumentasi Kali (Configuring the Kernel - SDR) hanya menyebut
# DVB_RTL2832_SDR. Tanpa DVB_USB_V2 + DVB_USB_RTL28XXU, RTL-SDR tidak muncul
# sebagai perangkat. Keduanya ada di tree ini.
#
# MEDIA_SUBDRV_AUTOSELECT sengaja dibiarkan y: docs minta n untuk image minimal,
# autoselect lebih aman terhadap dependency dan tidak membangun driver yang tak dipakai.

CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y

CONFIG_USB_AIRSPY=y
CONFIG_USB_HACKRF=y
CONFIG_USB_MSI2500=y
CONFIG_MEDIA_TUNER_MSI001=y

CONFIG_DVB_USB_V2=y
CONFIG_DVB_USB_RTL28XXU=y
CONFIG_DVB_RTL2830=y
CONFIG_DVB_RTL2832=y
CONFIG_DVB_RTL2832_SDR=y
CONFIG_DVB_SI2168=y
CONFIG_DVB_ZD1301_DEMOD=y
